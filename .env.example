# Noliae Mail OSS — exemple de configuration.
# Copie ce fichier en `.env` puis adapte les valeurs.
# ./install.sh peut générer les secrets automatiquement.

###################
# 1. DOMAINE
###################
# Ton domaine mail (utilisé pour les comptes user@MAIL_DOMAIN, MX, DKIM, SPF, DMARC).
MAIL_DOMAIN=mail.example.com
# Email administrateur (pour Let's Encrypt + premier compte créé).
ADMIN_EMAIL=admin@example.com

###################
# 2. SECRETS (à générer)
###################
APP_KEY=base64:CHANGE_ME
DB_PASSWORD=change-me-strong-random-string
MAIL_MASTER_PASS=change-me-strong-random-string
MINIO_ROOT_PASSWORD=change-me-strong-random-string

###################
# 3. INSCRIPTIONS
###################
# true : les visiteurs peuvent créer un compte @MAIL_DOMAIN
# false : seuls les comptes provisionnés peuvent se connecter (recommandé en prod)
ALLOW_REGISTRATION=true

###################
# 4. AVANCÉ (défauts sains, modifie en connaissance de cause)
###################
DB_NAME=noliaemail
DB_USER=noliae
MAIL_MASTER_USER=masteruser
MAIL_QUOTA_BYTES=5368709120
MINIO_ROOT_USER=noliae
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info
