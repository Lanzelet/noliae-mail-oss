# Noliae Mail OSS — exemple de configuration.
# Copie ce fichier en `.env` puis adapte les valeurs.
# ./install.sh peut générer les secrets automatiquement.

###################
# 1. DOMAINE
###################
# Ton domaine mail (utilisé pour les comptes user@MAIL_DOMAIN, MX, DKIM, SPF, DMARC).
MAIL_DOMAIN=mail.example.com
# Email administrateur (pour Let's Encrypt + premier compte créé).
ADMIN_EMAIL=admin@example.com
# Mot de passe initial du compte admin. Vide = généré aléatoirement et
# affiché dans les logs `docker compose logs web` au premier démarrage.
# Mets une valeur forte ici si tu veux pouvoir te connecter sans lire les logs.
ADMIN_PASSWORD=

# Démo : active le reset nightly à 03:00 UTC (purge tous les comptes non-admin,
# vide les boîtes partagées créées dans les 24h, purge audit_log > 7j).
# À NE PAS activer sur une instance de production réelle.
DEMO_RESET=false

###################
# 2. SECRETS (à générer)
###################
APP_KEY=base64:CHANGE_ME
DB_PASSWORD=change-me-strong-random-string
MAIL_MASTER_PASS=change-me-strong-random-string
MINIO_ROOT_PASSWORD=change-me-strong-random-string

###################
# 3. INSCRIPTIONS
###################
# true : les visiteurs peuvent créer un compte @MAIL_DOMAIN
# false : seuls les comptes provisionnés peuvent se connecter (recommandé en prod)
ALLOW_REGISTRATION=true

###################
# 4. AVANCÉ (défauts sains, modifie en connaissance de cause)
###################
DB_NAME=noliaemail
DB_USER=noliae
MAIL_MASTER_USER=masteruser
MAIL_QUOTA_BYTES=5368709120
MINIO_ROOT_USER=noliae
APP_ENV=production
APP_DEBUG=false
# URL publique (https + domaine derrière Traefik). install.sh la régénère depuis MAIL_DOMAIN.
APP_URL=https://mail.example.com
LOG_LEVEL=info

# IMAP : vide = plain (par défaut pour la stack interne docker où le webmail
# parle au Dovecot en réseau privé sans TLS). Mets "starttls" ou "ssl" si tu
# exposes Dovecot avec un cert TLS au lieu d'utiliser le réseau interne.
MAIL_IMAP_ENCRYPTION=
MAIL_IMAP_VALIDATE_CERT=false

# Mode de livraison sortante : "sync" (envoi immédiat via SendService)
# ou "queue" (publish sur RabbitMQ — nécessite un worker séparé).
# Auto-detecté : "sync" si RABBITMQ_URL vide, "queue" sinon.
MAIL_DELIVERY_MODE=sync

# Réseaux autorisés à relayer du courrier sortant via Postfix sans auth.
# Défaut sain : localhost + bridges Docker privés uniquement.
# N'AJOUTE PAS d'IP publique ici sauf si tu sais EXACTEMENT ce que tu fais.
MAIL_TRUSTED_NETS="127.0.0.0/8 [::1]/128 172.16.0.0/12"

# Token partagé entre le container web et le daemon Postfix queue
# (quarantaine spam + force-delivery via l'admin panel).
# Génère-en un fort : openssl rand -hex 32
POSTFIX_QUEUE_TOKEN=changeme-please-openssl-rand-hex-32

# Rspamd controller (laisser vide en dev, requis en prod)
RSPAMD_PASSWORD=

# Endpoint S3 public (MinIO) — les URLs presignees sont signees pour
# ce host, donc le navigateur de l'utilisateur DOIT pouvoir l'atteindre.
# Defaut : s3.<MAIL_DOMAIN> (Traefik route incluse dans le compose,
# cert Lets Encrypt automatique). Publier un record DNS A pour s3.<MAIL_DOMAIN>.
AWS_ENDPOINT=https://s3.mail.example.com
